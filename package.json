{
  "name": "blobbi",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@blobbi-kit/core": "^0.10.0",
    "@blobbi-kit/react": "^0.10.0",
    "@blobbi-kit/renderer": "^0.6.0",
    "@fontsource-variable/comfortaa": "^5.2.6",
    "@nostr-games/inventory": "^0.5.0",
    "@nostrify/nostrify": "^0.55.1",
    "@nostrify/react": "^0.6.8",
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^0.462.0",
    "nostr-tools": "^2.25.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.1",
    "vitest": "^3.2.7"
  },
  "description": "The home of your Blobbi: standalone Blobbi app built on the shared Blobbi Kit.",
  "engines": {
    "node": ">=22"
